      "description": "Test suite for API 1: Retrieve all products list, validate response code, response body, products array, object schema, and ID uniqueness.",
      "item": [
        {
          "name": "GET All Products - Status Code & Successful Response",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productsList"
              ]
            },
            "description": "Validates that GET /api/productsList returns HTTP 200 OK, acceptable response time, and responseCode 200 in the JSON body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. HTTP Status Code Validation",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2. Performance / Response Time Validation",
                  "pm.test(\"Response time is below 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// 3. Parse JSON and validate responseCode",
                  "pm.test(\"Response body contains responseCode 200\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET All Products - JSON Response Structure & Headers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productsList"
              ]
            },
            "description": "Validates JSON structure, root keys (responseCode and products), and notes Content-Type header quirk."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. JSON parsing validation",
                  "pm.test(\"Response is valid JSON\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"object\");",
                  "});",
                  "",
                  "// 2. Root keys existence",
                  "pm.test(\"Response contains required root keys: responseCode and products\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"responseCode\");",
                  "    pm.expect(jsonData).to.have.property(\"products\");",
                  "});",
                  "",
                  "// 3. Content-Type Header Inspection (Logged as Defect DEF-01 if text/html)",
                  "pm.test(\"Inspect Content-Type Header\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\");",
                  "    pm.expect(contentType).to.be.a(\"string\");",
                  "    if (!contentType.includes(\"application/json\")) {",
                  "        console.warn(\"[DEF-01] Known Quirk: Content-Type is '\" + contentType + \"' instead of 'application/json'\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
