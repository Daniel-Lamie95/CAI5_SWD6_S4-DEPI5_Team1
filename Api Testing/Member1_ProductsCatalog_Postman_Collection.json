            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"All product IDs are unique (no duplicates)\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const ids = jsonData.products.map(p => p.id);",
                  "    const uniqueIds = new Set(ids);",
                  "    pm.expect(uniqueIds.size, \"Unique ID count matches total products count\").to.eql(ids.length);",
                  "});",
                  "",
                  "pm.test(\"All product IDs are positive integers\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.products.forEach(p => {",
                  "        pm.expect(p.id).to.be.above(0);",
                  "    });",
                  "});"
                ]
