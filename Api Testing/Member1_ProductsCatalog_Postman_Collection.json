        {
          "name": "GET All Products - Product Fields & Schema Validation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productsList"
              ]
            },
            "description": "Validates that every single product object complies with the data contract schema: id (number), name (string), price (string), brand (string), and category (object)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"All products have valid schema and required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const products = jsonData.products;",
                  "    ",
                  "    products.forEach(function (product, index) {",
                  "        // Mandatory keys",
                  "        pm.expect(product, `Product [${index}] keys`).to.have.all.keys(\"id\", \"name\", \"price\", \"brand\", \"category\");",
                  "        ",
                  "        // Data types",
                  "        pm.expect(product.id, `Product [${index}].id type`).to.be.a(\"number\");",
                  "        pm.expect(product.name, `Product [${index}].name type`).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(product.price, `Product [${index}].price type`).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(product.brand, `Product [${index}].brand type`).to.be.a(\"string\");",
                  "        pm.expect(product.category, `Product [${index}].category type`).to.be.an(\"object\");",
                  "        ",
                  "        // Nested category structure",
                  "        pm.expect(product.category).to.have.property(\"usertype\");",
                  "        pm.expect(product.category.usertype).to.have.property(\"usertype\");",
                  "        pm.expect(product.category.usertype.usertype).to.be.a(\"string\");",
                  "        pm.expect(product.category).to.have.property(\"category\");",
                  "        pm.expect(product.category.category).to.be.a(\"string\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
