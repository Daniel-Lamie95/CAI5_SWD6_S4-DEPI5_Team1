    {
      "name": "Folder 3: Boundary Value Testing",
      "description": "Comprehensive boundary, security injection, input sanitation, and method unsupported testing.",
      "item": [
        {
          "name": "Boundary - Empty search_product Parameter (\"\")",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "search_product",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/searchProduct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "searchProduct"
              ]
            },
            "description": "Boundary Test: Evaluates behavior when search_product is present but empty. Notice: API returns responseCode 200 and dumps all 34 products (Logged as Defect DEF-03)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Expected according to strict spec vs Actual Defect DEF-03",
                  "pm.test(\"Check Empty Search Handling [DEF-03: Returns all products instead of 400 or empty]\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "    // Server returns all 34 products",
                  "    console.warn(\"[DEF-03] Actual Behavior: Empty search returned \" + jsonData.products.length + \" products.\");",
                  "    pm.expect(jsonData.products).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Boundary - Whitespace-Only Input (\"   \")",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
